{
  "name": "pointblank-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-clan Point Blank Indonesia Discord bot",
  "type": "module",
  "engines": { "node": ">=24.17.0 <25" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "check:config": "tsx scripts/check-config.ts",
    "check:discord": "tsx scripts/check-discord.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "pino": "^10.1.0",
    "playwright": "^1.64.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
